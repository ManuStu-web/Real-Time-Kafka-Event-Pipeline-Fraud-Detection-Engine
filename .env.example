# Server Configuration
PORT=3000
NODE_ENV=development

# Kafka Broker Configuration
KAFKA_CLIENT_ID=order-pipeline-service
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_ORDERS=order_events
KAFKA_TOPIC_DLQ=order_dlq
KAFKA_CONSUMER_GROUP=order-processing-group

# Processing & Business Logic Rules
FRAUD_THRESHOLD_AMOUNT=1000.00
PRODUCER_DELAY_MS=500

# Execution Mode:
# 'kafka' uses real Kafka broker via KafkaJS
# 'mock' uses in-memory broker (for instant local demonstration, testing, and CI without external containers)
EXECUTION_MODE=mock
